  },
  "homepage": "https://github.com/xdaniortega/ai-driven-development#readme",
  "bugs": "https://github.com/xdaniortega/ai-driven-development/issues",
  "type": "module",
  "bin": {
    "ai-driven-development": "bin/ai-driven-development.mjs"
